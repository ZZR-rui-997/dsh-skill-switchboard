{
  "name": "dsh-skill-switchboard",
  "version": "1.0.1",
  "type": "module",
  "description": "Sidebar skill switchboard for the DSH web client: list your own skills, switch model/user invocation, search bodies, check and fix spec problems, edit SKILL.md, create, import (folder or .zip), move, tag, delete and restore.",
  "engines": {
    "dsh": ">=0.2.2-rc.1",
    "node": ">=22"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.png",
    "./icon.png": "./icon.png"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/en.json",
    "locale/zh.json",
    "icon.svg",
    "icon.png",
    "docs/DETAIL.md",
    "docs/DETAIL.zh.md",
    "preview.svg",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "tests/smoke.test.js",
    "package.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-session"
      ]
    }
  },
  "icon": "./icon.png",
  "license": "MIT",
  "author": "ZZR-rui-997",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "deepseek-harness",
    "cordis",
    "skills",
    "skill-manager",
    "sidebar"
  ],
  "homepage": "https://github.com/ZZR-rui-997/dsh-skill-switchboard#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZZR-rui-997/dsh-skill-switchboard.git"
  },
  "bugs": {
    "url": "https://github.com/ZZR-rui-997/dsh-skill-switchboard/issues"
  },
  "scripts": {
    "check": "node --check index.js && node --check client.js",
    "test": "node tests/smoke.test.js"
  }
}
